// Cloudflare settings used while building the site with @opennextjs/cloudflare.
// The site is hosted on Cloudflare PAGES (nodes-bdffp.pages.dev): Pages runs
// `npm run build:pages` on every push and serves .open-next/assets. Pages
// ignores this file (it has no pages_build_output_dir); the compatibility
// flags below are set the same way in the Pages project settings.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "nodes-bdffp",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  }
}
