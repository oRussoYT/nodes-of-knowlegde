# NetPDBFF — example environment variables
#
# Copy this file to `.env.local` for local development and fill in real
# values there. Never commit `.env.local` or any file containing real
# secrets. `.env.local` is already excluded via .gitignore.
#
# NOTE: Supabase integration (auth, database wiring) is not implemented in
# application code yet — this milestone only establishes local/hosted
# Supabase development infrastructure (see docs/supabase-development.md).
# These variables are placeholders anticipating that future work, so the
# shape of the environment is established from the start of the project.
#
# This file intentionally lists only PUBLIC client configuration — values
# that are safe to bundle into browser code. Server-only secrets (e.g. the
# Supabase secret/service-role key) are NEVER placed here, even as empty
# placeholders. See "Credentials that must never be committed" in
# docs/supabase-development.md for where those belong.

# Public site URL, used for building absolute links (e.g. in emails, SEO).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase — public client configuration only ---------------------------
# Safe to expose to the browser. Get real values from the Supabase Dashboard
# (Project Settings > API Keys) for a hosted project, or from `supabase
# start` output for local development.

NEXT_PUBLIC_SUPABASE_URL=

# Current Supabase-recommended client key (replaces the legacy anon JWT key,
# which remains supported but is being phased out during 2026). See
# https://supabase.com/docs/guides/getting-started/api-keys.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional: an email address sent with OpenAlex lookups (their "polite pool",
# faster and more reliable). Server-only; never shown in the browser.
OPENALEX_MAILTO=
